      "parameters": {
        "jsCode": "const input = $input.first().json.body || $input.first().json;\nconst errors = [];\n\n// 1. Required fields check\nconst required = ['customer_name', 'email', 'subject', 'message', 'priority'];\nfor (const field of required) {\n  if (!input[field] || String(input[field]).trim() === '') {\n    errors.push(`Missing required field: ${field}`);\n  }\n}\n\n// 2. Email format validation\nconst emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\nif (input.email && !emailRegex.test(input.email)) {\n  errors.push('Invalid email format');\n}\n\n// 3. Priority enum validation\nconst validPriorities = ['High', 'Medium', 'Low'];\nif (input.priority && !validPriorities.includes(input.priority)) {\n  errors.push(`Invalid priority. Must be one of: ${validPriorities.join(', ')}`);\n}\n\nif (errors.length > 0) {\n  return [{ json: { valid: false, errors, original: input } }];\n}\n\nreturn [{\n  json: {\n    valid: true,\n    customer_name: String(input.customer_name).trim(),\n    email: String(input.email).trim().toLowerCase(),\n    subject: String(input.subject).trim(),\n    message: String(input.message).trim(),\n    priority: input.priority\n  }\n}];"
      },
      "id": "a1b2c3d4-0002-0002-0002-000000000002",
      "name": "Validate — Input Fields",
