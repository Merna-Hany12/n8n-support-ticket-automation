    {
      "parameters": {
        "jsCode": "const rows = $('Lookup — Recent Tickets').all().map(i => i.json);\nconst input = $('Validate — Input Fields').first().json;\n\n// Duplicate = same email + same subject, submitted within the last 24 hours\nconst DUPLICATE_WINDOW_HOURS = 24;\nconst now = Date.now();\n\nconst isDuplicate = rows.some(row => {\n  const rowEmail = row['Email'] || row.email;\n  const rowSubject = row['Subject'] || row.subject;\n  const rowCreatedRaw = row['Created Date'] || row.created_date;\n\n  if (!rowEmail || !rowSubject || !rowCreatedRaw) return false;\n\n  const rowCreatedTime = new Date(rowCreatedRaw).getTime();\n  if (isNaN(rowCreatedTime)) return false;\n\n  const hoursSinceCreated = (now - rowCreatedTime) / (1000 * 60 * 60);\n\n  return (\n    rowEmail.toLowerCase() === input.email.toLowerCase() &&\n    rowSubject === input.subject &&\n    hoursSinceCreated >= 0 &&\n    hoursSinceCreated < DUPLICATE_WINDOW_HOURS\n  );\n});\n\nreturn [{ json: { ...input, isDuplicate } }];"
      },
