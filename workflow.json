        "jsCode": "const ticket = $('Prepare — Ticket Data').first().json;\nconst apiResponse = $input.first().json;\n\nconst warnings = [];\n\nif (apiResponse.error) {\n  let errorMsg = apiResponse.error.message || apiResponse.error;\n  warnings.push('External API forwarding failed: ' + errorMsg);\n}\n\nconst response = {\n  success: true,\n  ticket_created: true,\n  ticket_id: ticket['Ticket ID'],\n  category: ticket['Category'],\n  priority: ticket['Priority'],\n  message: 'Your support ticket has been received and is being processed.'\n};\n\nif (warnings.length > 0) {\n  response.warnings = warnings;\n}\n\nreturn [{ json: response }];"
