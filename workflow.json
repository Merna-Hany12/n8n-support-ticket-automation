        "jsCode": "const input = $('Check — Duplicate Ticket').first().json;\nconst ai = $('Parse — AI Response').first().json;\n\nconst ticket_id = 'TKT-' + Date.now() + '-' + Math.random().toString(36).substr(2, 6).toUpperCase();\n\nreturn [{\n  json: {\n    'Ticket ID': ticket_id,\n    'Customer Name': input.customer_name,\n    'Email': input.email,\n    'Subject': input.subject,\n    'Message': input.message,\n    'Priority': input.priority,\n    'Category': ai.category,\n    'Summary': ai.summary,\n    'Sentiment': ai.sentiment,\n    'Created Date': new Date().toISOString(),\n    'Status': 'Open'\n  }\n}];"
