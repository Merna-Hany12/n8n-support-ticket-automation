        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"{{ $vars.AI_MODEL || 'gpt-4o-mini' }}\",\n  \"response_format\": { \"type\": \"json_object\" },\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a customer support ticket classifier. Analyze tickets and return ONLY valid JSON with exactly these fields: category (one of: Technical Issue, Billing, Account Access, General Inquiry, Bug Report, Feature Request), summary (one concise sentence), sentiment (one of: Positive, Neutral, Negative).\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Ticket Details:\\nCustomer: {{ $('Check — Duplicate Ticket').item.json.customer_name }}\\nSubject: {{ $('Check — Duplicate Ticket').item.json.subject }}\\nMessage: {{ $('Check — Duplicate Ticket').item.json.message }}\\nPriority: {{ $('Check — Duplicate Ticket').item.json.priority }}\"\n    }\n  ],\n  \"temperature\": 0\n}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "a1b2c3d4-0009-0009-0009-000000000009",
      "name": "AI — Analyze Ticket",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1560,
        380
      ],
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\n\nlet parsed = {};\ntry {\n  if (raw.choices && raw.choices[0]) {\n    const content = raw.choices[0].message.content;\n    parsed = typeof content === 'string' ? JSON.parse(content) : content;\n  } else if (raw.error) {\n    console.log('AI Error:', JSON.stringify(raw.error));\n    parsed = {};\n  } else {\n    parsed = raw;\n  }\n} catch (e) {\n  console.log('AI parse error:', e.message);\n  parsed = {};\n}\n\nconst validCategories = ['Technical Issue', 'Billing', 'Account Access', 'General Inquiry', 'Bug Report', 'Feature Request'];\nconst validSentiments = ['Positive', 'Neutral', 'Negative'];\n\nconst result = {\n  category: validCategories.includes(parsed.category) ? parsed.category : 'General Inquiry',\n  summary: parsed.summary || 'Customer submitted a support request.',\n  sentiment: validSentiments.includes(parsed.sentiment) ? parsed.sentiment : 'Neutral',\n  ai_processed: !!parsed.category\n};\n\nreturn [{ json: result }];"
      },
